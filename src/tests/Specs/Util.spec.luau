--!strict
-- Tests des utilitaires partagés (Validate, Signal, Trove).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Validate = require(Shared.Util.Validate)
local Signal = require(Shared.Util.Signal)
local Trove = require(Shared.Util.Trove)

return function(t)
	t.describe("Validate", function()
		t.it("refuse NaN et l'infini", function()
			t.expect(Validate.isFiniteNumber(0 / 0)).toBeFalsy()
			t.expect(Validate.isFiniteNumber(math.huge)).toBeFalsy()
			t.expect(Validate.isFiniteNumber(-math.huge)).toBeFalsy()
			t.expect(Validate.isFiniteNumber(3.5)).toBeTruthy()
		end)
		t.it("vérifie les Vector3", function()
			t.expect(Validate.isFiniteVector3(Vector3.new(1, 2, 3))).toBeTruthy()
			t.expect(Validate.isFiniteVector3(Vector3.new(0 / 0, 0, 0))).toBeFalsy()
			t.expect(Validate.isFiniteVector3("x")).toBeFalsy()
		end)
		t.it("checkArgs accepte une liste conforme", function()
			local ok = Validate.checkArgs({ "integer", "Vector3", "number?" }, 3, Vector3.one)
			t.expect(ok).toBeTruthy()
		end)
		t.it("checkArgs rejette un type faux, un manque et un surplus", function()
			t.expect((Validate.checkArgs({ "integer" }, 1.5))).toBeFalsy()
			t.expect((Validate.checkArgs({ "integer", "boolean" }, 1))).toBeFalsy()
			t.expect((Validate.checkArgs({ "integer" }, 1, 2))).toBeFalsy()
		end)
		t.it("checkArgs borne la longueur des chaînes", function()
			t.expect((Validate.checkArgs({ "string:4" }, "abcd"))).toBeTruthy()
			t.expect((Validate.checkArgs({ "string:4" }, "abcde"))).toBeFalsy()
			t.expect((Validate.checkArgs({ "string" }, string.rep("a", 201)))).toBeFalsy()
		end)
		t.it("flatUnit retourne une direction horizontale unitaire", function()
			local dir = Validate.flatUnit(Vector3.new(3, 50, 4))
			t.expect(dir).notToBeNil()
			t.expect((dir :: Vector3).Magnitude).toBeCloseTo(1, 1e-5)
			t.expect((dir :: Vector3).Y).toBe(0)
			t.expect(Validate.flatUnit(Vector3.new(0, 5, 0))).toBeNil()
		end)
		t.it("clampNumber remplace les valeurs invalides", function()
			t.expect(Validate.clampNumber(0 / 0, 0, 1, 0.5)).toBe(0.5)
			t.expect(Validate.clampNumber(5, 0, 1, 0.5)).toBe(1)
		end)
	end)

	t.describe("Signal", function()
		t.it("transmet les arguments et se déconnecte", function()
			local signal = Signal.new()
			local received = nil
			local connection = signal:Connect(function(value)
				received = value
			end)
			signal:Fire(42)
			t.expect(received).toBe(42)
			connection:Disconnect()
			signal:Fire(7)
			t.expect(received).toBe(42)
			t.expect(signal:GetConnectionCount()).toBe(0)
		end)
		t.it("Once ne se déclenche qu'une fois", function()
			local signal = Signal.new()
			local count = 0
			signal:Once(function()
				count += 1
			end)
			signal:Fire()
			signal:Fire()
			t.expect(count).toBe(1)
		end)
	end)

	t.describe("Trove", function()
		t.it("nettoie instances, fonctions et connexions", function()
			local trove = Trove.new()
			local holder = Instance.new("Folder")
			local part = Instance.new("Part")
			part.Parent = holder
			local called = false
			trove:Add(part)
			trove:Add(function()
				called = true
			end)
			local signal = Signal.new()
			trove:Connect(signal, function() end)
			t.expect(trove:Count()).toBe(3)
			trove:Clean()
			t.expect(called).toBeTruthy()
			t.expect(part.Parent).toBeNil()
			t.expect(signal:GetConnectionCount()).toBe(0)
			t.expect(trove:Count()).toBe(0)
		end)
	end)
end
