--!strict
-- Logic.Inventory et Logic.ItemGeometry : règles pures des objets (cases, cônes, rayons).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Inventory = require(Shared.Logic.Inventory)
local ItemGeometry = require(Shared.Logic.ItemGeometry)

return function(t)
	t.describe("Inventory", function()
		t.it("ajoute dans la première case vide et refuse quand il est plein", function()
			local inv = Inventory.new(2)
			t.expect(Inventory.add(inv, "horn")).toBe(1)
			t.expect(Inventory.add(inv, "espresso")).toBe(2)
			t.expect(Inventory.isFull(inv)).toBe(true)
			t.expect(Inventory.add(inv, "frost_bomb") == nil).toBe(true)
		end)

		t.it("retire un objet et libère la case", function()
			local inv = Inventory.new(3)
			Inventory.add(inv, "horn")
			Inventory.add(inv, "espresso")
			t.expect(Inventory.remove(inv, 1)).toBe("horn")
			t.expect(Inventory.get(inv, 1) == nil).toBe(true)
			t.expect(Inventory.add(inv, "mega_burger")).toBe(1)
			t.expect(Inventory.remove(inv, 3) == nil).toBe(true)
		end)

		t.it("sélection bornée à 1..capacité et cycle dans les deux sens", function()
			local inv = Inventory.new(3)
			t.expect(Inventory.select(inv, 4)).toBe(false)
			t.expect(Inventory.select(inv, 0)).toBe(false)
			t.expect(Inventory.select(inv, 2)).toBe(true)
			Inventory.selectNext(inv, 1)
			t.expect(inv.selected).toBe(3)
			Inventory.selectNext(inv, 1)
			t.expect(inv.selected).toBe(1)
			Inventory.selectNext(inv, -1)
			t.expect(inv.selected).toBe(3)
		end)

		t.it("sérialise au format de l'attribut Inventory et le relit", function()
			local inv = Inventory.new(3)
			Inventory.add(inv, "horn")
			inv.slots[3] = "espresso"
			t.expect(Inventory.serialize(inv)).toBe("horn,,espresso")
			local back = Inventory.parse("horn,,espresso", 3)
			t.expect(Inventory.get(back, 3)).toBe("espresso")
			t.expect(Inventory.count(back)).toBe(2)
			t.expect(Inventory.serialize(Inventory.new(2))).toBe(",")
		end)

		t.it("réduire la capacité perd les cases en trop et recadre la sélection", function()
			local inv = Inventory.new(4)
			inv.slots[4] = "horn"
			inv.selected = 4
			Inventory.setCapacity(inv, 2)
			t.expect(inv.capacity).toBe(2)
			t.expect(inv.selected).toBe(2)
			t.expect(Inventory.count(inv)).toBe(0)
			Inventory.setCapacity(inv, 3)
			t.expect(Inventory.serialize(inv)).toBe(",,")
		end)
	end)

	t.describe("ItemGeometry", function()
		local origin = Vector3.new(0, 0, 0)
		local forward = Vector3.new(0, 0, -1)

		t.it("cône : dedans, hors angle et hors portée", function()
			t.expect(ItemGeometry.inCone(origin, forward, Vector3.new(0, 0, -10), 15, 25)).toBe(true)
			t.expect(ItemGeometry.inCone(origin, forward, Vector3.new(10, 0, -10), 15, 25)).toBe(false)
			t.expect(ItemGeometry.inCone(origin, forward, Vector3.new(0, 0, -30), 15, 25)).toBe(false)
			t.expect(ItemGeometry.inCone(origin, forward, Vector3.new(0, 0, 5), 30, 25)).toBe(false)
		end)

		t.it("orientation : tourné vers la cible ou non", function()
			local target = Vector3.new(0, 0, -10)
			t.expect(ItemGeometry.facing(origin, target, forward, 0.2)).toBe(true)
			t.expect(ItemGeometry.facing(origin, target, Vector3.new(0, 0, 1), 0.2)).toBe(false)
		end)

		t.it("rayon : touche une sphère devant, rate celle de côté ou derrière", function()
			t.expect(ItemGeometry.rayHitsSphere(origin, forward, Vector3.new(0, 0, -20), 1.5, 140) ~= nil).toBe(true)
			t.expect(ItemGeometry.rayHitsSphere(origin, forward, Vector3.new(5, 0, -20), 1.5, 140) == nil).toBe(true)
			t.expect(ItemGeometry.rayHitsSphere(origin, forward, Vector3.new(0, 0, 20), 1.5, 140) == nil).toBe(true)
			t.expect(ItemGeometry.rayHitsSphere(origin, forward, Vector3.new(0, 0, -200), 1.5, 140) == nil).toBe(true)
		end)

		t.it("tri le long du rayon : du plus proche au plus lointain", function()
			local points = { Vector3.new(0, 0, -60), Vector3.new(0, 0, -10), Vector3.new(4, 0, -30), Vector3.new(0, 0, -30) }
			local hits = ItemGeometry.sortAlongRay(origin, forward, points, 1.5, 140)
			t.expect(#hits).toBe(3)
			t.expect(hits[1].index).toBe(2)
			t.expect(hits[2].index).toBe(4)
			t.expect(hits[3].index).toBe(1)
		end)

		t.it("décroissance : pleine, linéaire puis nulle", function()
			t.expect(ItemGeometry.falloff(5, 12, 25)).toBe(1)
			t.expect(ItemGeometry.falloff(25, 12, 25)).toBe(0)
			t.expect(math.abs(ItemGeometry.falloff(18.5, 12, 25) - 0.5) < 1e-6).toBe(true)
		end)

		t.it("direction de recul horizontale, définie même à distance nulle", function()
			local direction = ItemGeometry.knockDirection(Vector3.new(0, 5, 0), Vector3.new(10, 0, 0))
			t.expect(direction.Y).toBe(0)
			t.expect(math.abs(direction.X - 1) < 1e-6).toBe(true)
			t.expect(ItemGeometry.knockDirection(origin, origin).Magnitude > 0.5).toBe(true)
		end)

		t.it("meilleur placé : plus petite distance restante, hors exclu", function()
			local candidates = { { id = 1, remaining = 50 }, { id = 2, remaining = 20 }, { id = 3, remaining = 35 } }
			t.expect(ItemGeometry.bestPlaced(candidates, nil)).toBe(2)
			t.expect(ItemGeometry.bestPlaced(candidates, 2)).toBe(3)
			t.expect(ItemGeometry.bestPlaced({}, nil) == nil).toBe(true)
		end)
	end)
end
